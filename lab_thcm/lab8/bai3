def generate_dual_problem(c_primal, A_primal, b_primal):
    # Vector hàm mục tiêu đối ngẫu c_dual chính là b_primal
    c_dual = b_primal
    
    # Ma trận ràng buộc đối ngẫu A_dual = A_primal^T (chuyển vị)
    num_rows = len(A_primal)
    num_cols = len(A_primal[0])
    A_dual = [[A_primal[i][j] for i in range(num_rows)] for j in range(num_cols)]
    
    # Vector về phải đối ngẫu b_dual = c_primal
    b_dual = c_primal
    
    return c_dual, A_dual, b_dual

# Kiểm chứng Định lý Đối ngẫu mạnh
c_primal = [40, 30]
A_primal = [[2, 1], [1, 1]]
b_primal = [100, 80]

c_dual, A_dual, b_dual = generate_dual_problem(c_primal, A_primal, b_primal)

x_star = [20, 60]
y_star = [10, 20]

# Tính giá trị hàm mục tiêu bài toán gốc: c^T * x
primal_obj = sum(c_primal[i] * x_star[i] for i in range(len(c_primal)))
# Tính giá trị hàm mục tiêu bài toán đối ngẫu: b^T * y
dual_obj = sum(b_primal[j] * y_star[j] for j in range(len(b_primal)))

print("Vector hàm mục tiêu đối ngẫu c_dual:", c_dual)
print("Ma trận A_dual (Chuyển vị):", A_dual)
print("Giá trị hàm mục tiêu bài toán Gốc (Primal):", primal_obj)
print("Giá trị hàm mục tiêu bài toán Đối ngẫu (Dual):", dual_obj)
print(f"Định lý Đối ngẫu mạnh thỏa mãn: {primal_obj} == {dual_obj} == 2600")