def solve_lp_geometric(vertices, c1, c2):
    best_val = -float('inf')  # Sửa lỗi khởi tạo ban đầu từ inf thành -inf để tìm max
    best_vertex = None
    
    for x1, x2 in vertices:
        # Tính giá trị hàm mục tiêu f = c1*x1 + c2*x2
        current_val = c1 * x1 + c2 * x2
        print(f"Đỉnh ({x1}, {x2}) -> Giá trị f = {current_val}")
        
        if current_val > best_val:
            best_val = current_val
            best_vertex = (x1, x2)
            
    return best_vertex, best_val

# Chạy thử nghiệm
vertices = [(0, 0), (0, 80), (20, 60), (50, 0)]
c1, c2 = 40, 30
optimal_point, max_profit = solve_lp_geometric(vertices, c1, c2)

print(f"\nNghiệm tối ưu: {optimal_point}")
print(f"Lợi nhuận tối đa: {max_profit} USD")
# Kết quả kỳ vọng: Nghiệm tối ưu: (20, 60) | Lợi nhuận tối đa: 2600 USD